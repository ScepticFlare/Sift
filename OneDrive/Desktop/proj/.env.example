# ============================================================
#  SIFT — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ------ AI Backend ------
# Options: "offline" (no API needed), "gemini" (free), or "claude" (paid)
AI_BACKEND=offline

# ------ Gemini API (Google) — FREE ------
# Get a free key at https://aistudio.google.com/apikey
# No credit card needed.
GEMINI_API_KEY=

# ------ Claude API (Anthropic) — PAID ------
# Only needed if AI_BACKEND=claude
# Sign up at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ------ Email (SMTP) Settings ------
# For Gmail:
#   1. Enable 2-Factor Auth on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an "App Password" (16 characters)
#   4. Use that as SMTP_PASSWORD below
#
# For Outlook: smtp-mail.outlook.com / 587
# For Yahoo: smtp.mail.yahoo.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ------ Sender & Recipients ------
SENDER_EMAIL=your-email@gmail.com
SUBSCRIBERS=reader1@example.com,reader2@example.com

# ------ Schedule ------
# Hour (24h format) to send the daily digest
DIGEST_HOUR=07:00
